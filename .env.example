# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# SteamGridDB API Key (optional, for ultra high-res game box covers)
STEAMGRIDDB_API_KEY=your_steamgriddb_api_key_here

# Polling interval in minutes for background checks (default: 60)
CHECK_INTERVAL_MINUTES=60

# Database file path
DATABASE_PATH=data/free_games.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
